FROM grafana/grafana@sha256:0615ec4fbd4072004b7d86b46ded63013a74b7d6eb1119273dd89e8fa25c13cf
COPY monitoring/railway/datasource.yml /etc/grafana/provisioning/datasources/prometheus.yml
