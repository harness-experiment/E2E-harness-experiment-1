    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "6.4.6"
  }
